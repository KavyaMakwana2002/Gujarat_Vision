# ==============================================================
# Sentinel Shield 2.4 — Python AI Surveillance Server Environment
# ==============================================================

# Network Binding (Render automatically assigns PORT)
HOST=0.0.0.0
PORT=8000

# Python Runtime Version for Render Cloud
PYTHON_VERSION=3.10.12

# JWT Authentication Secret Key (Generate a random secure string)
JWT_SECRET=GUJARAT_CYBER_VISION_SENTINEL_SECURE_KEY_2026_!#*99

# RTSP Video Stream Ingestion Options (Forces TCP)
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
